# ─────────────────────────────────────────────────────────────
# Variables d'environnement — site botanic studio
# Copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais committer un .env contenant une vraie clé.
# ─────────────────────────────────────────────────────────────

# URL de la fonction qui reçoit le formulaire de contact.
# Laisser vide si le site et la fonction sont déployés ensemble
# sur Vercel : /api/contact est alors utilisé automatiquement.
VITE_CONTACT_API_URL=

# Clé API Resend, côté serveur uniquement (jamais exposée au navigateur).
# À créer sur https://resend.com puis à saisir dans Vercel.
RESEND_API_KEY=
